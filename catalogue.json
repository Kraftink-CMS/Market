        {
            "id": "kraftink-cms/faq",
            "slug": "faq",
            "type": "plugin",
            "name": {
                "de": "Häufige Fragen",
                "en": "FAQ",
                "es": "Preguntas frecuentes",
                "fr": "FAQ",
                "pt": "Perguntas frequentes"
            },
            "description": {
                "de": "Häufige Fragen der Community.",
                "en": "Publish answers that players can search or browse by category.",
                "es": "Preguntas frecuentes de la comunidad.",
                "fr": "Publiez des réponses que vos joueurs peuvent retrouver par recherche ou par catégorie.",
                "pt": "Perguntas frequentes da comunidade."
            },
            "readme": {
                "en": "Explain how to join your server, where to download the launcher or whom to contact about a problem. Players can find those answers in one place.\n\n- Group related questions and add images to answers that need a walkthrough.\n- Keep answers as drafts until they are ready to publish.\n- Link translations of a question when your site offers more than one language.\n\nAfter installing FAQ, open **Extensions → Frequently asked questions** to create your first category and publish an answer.\n",
                "fr": "Expliquez comment rejoindre le serveur, où télécharger le lanceur ou à qui signaler un problème. Les joueurs retrouvent ces informations au même endroit.\n\n- Regroupez les questions par sujet et illustrez les étapes avec des images.\n- Gardez vos réponses en brouillon avant de les publier.\n- Reliez les traductions d’une même question si votre site propose plusieurs langues.\n\nAprès l’installation, ouvrez **Extensions → Questions fréquentes** pour créer une catégorie et publier votre première réponse.\n"
            },
            "icon": "question-circle",
            "author": {
                "id": "kraftink-cms",
                "name": "nivcoo, KraftInk",
                "url": "https://github.com/kraftink-cms"
            },
            "repository": "https://github.com/Kraftink-CMS/Plugin-Faq",
            "commercial": {
